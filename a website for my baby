
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>For You ♡</title>

<style>
:root {
  --pink: #e783a0;
  --deep-pink: #cf6486;
  --pale-pink: #fff0f5;
  --ink: #625362;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html {
  scroll-behavior: smooth;
  scroll-padding-top: 85px;
}

body {
  font-family: Georgia, "Times New Roman", serif;
  color: var(--ink);
  background:
    radial-gradient(ellipse at 10% 20%, #fff 0%, transparent 45%),
    linear-gradient(135deg, #fff8fa, #fbe3ec, #fff4f7);
  overflow-x: hidden;
}

a { text-decoration: none; }

nav {
  position: sticky;
  top: 0;
  z-index: 20;
  padding: 14px 7%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18px;
  flex-wrap: wrap;
  background: rgba(255,250,252,.9);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid #f5d4df;
}

.logo {
  color: var(--pink);
  font-family: "Brush Script MT", "Segoe Script", cursive;
  font-size: 31px;
}

.nav-links {
  display: flex;
  flex-wrap: wrap;
  gap: 24px;
}

.nav-links a {
  font-size: 14px;
  color: #b47c90;
  transition: .25s;
}

.nav-links a:hover { color: var(--deep-pink); }

.hero {
  min-height: 58vh;
  padding: 65px 20px;
  display: grid;
  place-items: center;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.hero-content { position: relative; z-index: 2; }

.eyebrow {
  color: var(--pink);
  letter-spacing: 3px;
  font-size: 12px;
  text-transform: uppercase;
}

h1 {
  color: var(--pink);
  font-weight: normal;
  font-size: clamp(65px, 12vw, 105px);
  line-height: 1.2;
  margin: 10px 0;
}

.hero p {
  font-size: 21px;
  color: #c28b9f;
  font-style: italic;
}

.button {
  display: inline-block;
  padding: 12px 27px;
  margin-top: 24px;
  color: white;
  background: var(--pink);
  border-radius: 30px;
  box-shadow: 0 7px 20px #d66e9130;
  transition: .25s;
}

.button:hover {
  background: var(--deep-pink);
  transform: translateY(-3px);
}

.heart-divider {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16px;
  color: var(--pink);
  margin: 22px auto;
}

.heart-divider::before,
.heart-divider::after {
  content: "";
  width: 85px;
  height: 1px;
  background: #eab4c5;
}

.side-note {
  position: absolute;
  top: 35%;
  left: 5%;
  font-family: "Brush Script MT", cursive;
  font-size: 27px;
  color: #d99aaf;
  transform: rotate(-9deg);
  z-index: 2;
}

/* Decorative pink lilies */
.lily {
  position: absolute;
  width: 240px;
  height: 300px;
  pointer-events: none;
  opacity: .76;
  z-index: 0;
}

.lily-left { left: -65px; bottom: 0; }
.lily-right { right: -55px; top: 35px; transform: rotate(-15deg); }

.lily svg { width: 100%; height: 100%; overflow: visible; }

section { padding: 35px 20px 65px; }

.letter {
  max-width: 850px;
  margin: 0 auto;
  padding: clamp(25px, 6vw, 65px);
  background: rgba(255,255,255,.87);
  border: 1px solid #f5d6e1;
  border-radius: 10px;
  box-shadow: 0 15px 45px #c7829a20;
  position: relative;
  z-index: 2;
}

h2 {
  font-size: clamp(35px, 6vw, 49px);
  color: var(--pink);
  font-weight: normal;
  text-align: center;
}

.subtitle {
  text-align: center;
  color: #c58da0;
  font-style: italic;
  margin: 6px 0 35px;
}

.letter p {
  font-size: 16px;
  line-height: 1.9;
  margin-bottom: 23px;
}

.signature { margin-top: 32px; }

.memories {
  max-width: 1000px;
  margin: auto;
  position: relative;
  z-index: 2;
}

.section-description {
  text-align: center;
  color: #bf8da0;
  font-style: italic;
  margin-top: 8px;
}

.memory-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
  margin-top: 32px;
}

.memory-card {
  text-align: center;
  padding: 24px 18px;
  border-radius: 14px;
  border: 1px solid #f5d5e0;
  background: rgba(255,255,255,.8);
  box-shadow: 0 8px 25px #d78ca01a;
  transition: .3s;
}

.memory-card:hover { transform: translateY(-5px); }

.memory-icon { font-size: 35px; }

.memory-card h3 {
  color: var(--pink);
  font-weight: normal;
  font-size: 20px;
  margin: 12px 0;
}

.memory-card p {
  font-size: 14px;
  line-height: 1.8;
}

.future {
  max-width: 750px;
  margin: auto;
  text-align: center;
  padding: 35px 25px;
  position: relative;
  z-index: 2;
}

.future p {
  line-height: 1.9;
  margin-top: 16px;
}

footer {
  padding: 25px 15px;
  text-align: center;
  color: #c18ba0;
  border-top: 1px solid #f3d5df;
  background: #fff7faad;
}

.floating-heart {
  position: fixed;
  z-index: 30;
  bottom: -30px;
  pointer-events: none;
  color: #e58ca7;
  animation: floatUp linear forwards;
}

@keyframes floatUp {
  to {
    transform: translateY(-110vh) rotate(35deg);
    opacity: 0;
  }
}

@media(max-width:700px) {
  nav { padding: 12px 5%; }
  .nav-links { gap: 13px; }
  .nav-links a { font-size: 12px; }
  .hero { min-height: 52vh; }
  .side-note { display: none; }
  .lily { width: 135px; height: 190px; opacity: .45; }
  .lily-left { left: -48px; }
  .lily-right { right: -45px; }
  .memory-grid { grid-template-columns: 1fr; }
  .letter p { font-size: 15px; }
}

@media(prefers-reduced-motion:reduce) {
  html { scroll-behavior: auto; }
  .floating-heart { display: none; }
  * { animation: none !important; transition: none !important; }
}
</style>
</head>

<body>

<nav>
  <a href="#home" class="logo">For You ♡</a>
  <div class="nav-links">
    <a href="#home">Home</a>
    <a href="#letter">Letter</a>
    <a href="#memories">Our Memories</a>
    <a href="#forever">Forever?</a>
  </div>
</nav>

<header class="hero" id="home">

  <div class="lily lily-right" aria-hidden="true">
    <svg viewBox="0 0 220 280" xmlns="http://www.w3.org/2000/svg">
      <path d="M130 285 Q145 170 125 65" fill="none" stroke="#879d70" stroke-width="5"/>
      <path d="M130 220 Q55 160 40 190 Q83 222 130 220" fill="#9eaf80"/>
      <path d="M128 180 Q192 112 205 146 Q173 180 128 180" fill="#a9b88a"/>
      <g transform="translate(120 90)">
        <ellipse cy="-43" rx="24" ry="57" fill="#f8c0d0" transform="rotate(-8)"/>
        <ellipse cy="-43" rx="24" ry="57" fill="#f7b3c6" transform="rotate(55)"/>
        <ellipse cy="-43" rx="24" ry="57" fill="#fbd0dc" transform="rotate(115)"/>
        <ellipse cy="-43" rx="24" ry="57" fill="#f4a9c0" transform="rotate(175)"/>
        <ellipse cy="-43" rx="24" ry="57" fill="#fbd3df" transform="rotate(235)"/>
        <ellipse cy="-43" rx="24" ry="57" fill="#f6b7ca" transform="rotate(295)"/>
        <circle r="10" fill="#f6d99a"/>
        <g stroke="#b98592" stroke-width="1.5">
          <path d="M0 0 L-10 -45 M0 0 L8 -51 M0 0 L28 -32"/>
        </g>
        <g fill="#b28b45">
          <circle cx="-10" cy="-45" r="3"/>
          <circle cx="8" cy="-51" r="3"/>
          <circle cx="28" cy="-32" r="3"/>
        </g>
      </g>
    </svg>
  </div>

  <div class="side-note">Some things are<br>still worth<br>saying... ♡</div>

  <div class="hero-content">
    <div class="eyebrow">A little piece of my heart</div>
    <h1>To You</h1>
    <p>A letter from my heart</p>
    <div class="heart-divider">♡</div>
    <a class="button" href="#letter">Read My Letter →</a>
  </div>
</header>

<main>

<section id="letter">

  <div class="lily lily-left" aria-hidden="true">
    <svg viewBox="0 0 220 280" xmlns="http://www.w3.org/2000/svg">
      <path d="M80 285 Q90 190 115 70" fill="none" stroke="#8ba177" stroke-width="5"/>
      <path d="M90 220 Q20 160 8 190 Q50 222 90 220" fill="#a9b88a"/>
      <path d="M104 180 Q170 115 195 145 Q153 180 104 180" fill="#92a879"/>
      <g transform="translate(112 90)">
        <ellipse cy="-43" rx="24" ry="57" fill="#f8c0d0" transform="rotate(-8)"/>
        <ellipse cy="-43" rx="24" ry="57" fill="#f7b3c6" transform="rotate(55)"/>
        <ellipse cy="-43" rx="24" ry="57" fill="#fbd0dc" transform="rotate(115)"/>
        <ellipse cy="-43" rx="24" ry="57" fill="#f4a9c0" transform="rotate(175)"/>
        <ellipse cy="-43" rx="24" ry="57" fill="#fbd3df" transform="rotate(235)"/>
        <ellipse cy="-43" rx="24" ry="57" fill="#f6b7ca" transform="rotate(295)"/>
        <circle r="10" fill="#f6d99a"/>
        <g stroke="#b98592" stroke-width="1.5">
          <path d="M0 0 L-10 -45 M0 0 L8 -51 M0 0 L28 -32"/>
        </g>
        <g fill="#b28b45">
          <circle cx="-10" cy="-45" r="3"/>
          <circle cx="8" cy="-51" r="3"/>
          <circle cx="28" cy="-32" r="3"/>
        </g>
      </g>
    </svg>
  </div>

  <article class="letter">
    <div class="heart-divider">♡</div>
    <h2>To You</h2>
    <div class="subtitle">A letter from my heart</div>

    <p>
      I don't really know where to begin, or if these are even
      the right words to say, but there are things in my heart
      that I want you to understand. I've spent a lot of time
      thinking about us, about everything we've shared, and
      about the things I never got to express the way I wanted
      to. So I decided to write this letter, not because I
      expect anything from you, but because what we had meant
      so much to me.
    </p>

    <p>
      When I look back at our three years together, I realize
      how lucky I was to have you in my life. You were there
      in the little moments and the big ones — in the random
      conversations, the late-night talks, the laughs, the
      comfort, and even the hard times. You made my days
      brighter, and you became someone who truly mattered to me.
    </p>

    <p>
      I know there were also problems, and I understand that
      there are things I might not have seen or fully understood
      at the time. I know I wasn't perfect either. I've been
      reflecting on my part in all of this, and I want you to
      know that I'm sorry for the times I fell short. I've
      learned a lot, and I'm trying to be a better version of
      myself — not just for you, but for my own future, too.
    </p>

    <p>
      I still love you. That hasn't changed. But I also
      understand and respect your decision, even if it's hard
      for me to accept. You deserve to be happy, and I want you
      to have that, no matter what. If we ever find our way
      back to each other, I hope it will be when we're both
      better, stronger, and truly ready. I don't want us to
      return to the same problems; I'd want us to understand
      each other better and grow together. And if that's not
      what life has planned for us, I'll still be grateful for
      everything we had.
    </p>

    <p>
      Thank you for being part of my life. You taught me so
      much, and I'll always cherish our memories. No matter
      what happens, the time we shared will always be an
      important part of my story.
    </p>

    <p class="signature">
      Take care, always.<br>
      — Errol
    </p>

    <div class="heart-divider">♡</div>
  </article>
</section>

<section id="memories">
  <div class="memories">
    <h2>Our Memories</h2>
    <p class="section-description">
      The little moments that meant so much.
    </p>

    <div class="memory-grid">
      <article class="memory-card">
        <div class="memory-icon">🌷</div>
        <h3>The Little Moments</h3>
        <p>
          The ordinary days that became special because
          we shared them together.
        </p>
      </article>

      <article class="memory-card">
        <div class="memory-icon">☁️</div>
        <h3>The Talks & Laughter</h3>
        <p>
          The conversations, the jokes, and the comfort
          I'll always remember.
        </p>
      </article>

      <article class="memory-card">
        <div class="memory-icon">🩷</div>
        <h3>What We Learned</h3>
        <p>
          The ways our time together helped us learn
          about love and ourselves.
        </p>
      </article>
    </div>

    <p class="section-description" style="margin-top:22px">
      Some memories stay with us, even when life changes.
    </p>
  </div>
</section>

<section id="forever">
  <div class="future">
    <div class="heart-divider">♡</div>
    <h2>Forever?</h2>

    <p>
      I'm not writing this to ask you for an answer or to
      change your mind. I just wanted to be honest about
      what you mean to me. Whatever the future holds, I
      hope life is gentle with you, and I hope we both keep
      growing into the people we want to become.
    </p>

    <p style="color:#c47d96;font-style:italic">
      Thank you for everything. ♡
    </p>

    <a class="button" href="#home">Back to the Beginning ↑</a>
  </div>
</section>

</main>

<footer>
  Made with care, from Errol ♡
</footer>

<script>
const reducedMotion = window.matchMedia(
  "(prefers-reduced-motion: reduce)"
).matches;

if (!reducedMotion) {
  function createHeart() {
    const heart = document.createElement("span");

    heart.className = "floating-heart";
    heart.textContent = Math.random() > 0.5 ? "♡" : "♥";
    heart.style.left = Math.random() * 100 + "vw";
    heart.style.fontSize = (12 + Math.random() * 17) + "px";

    const duration = 7 + Math.random() * 6;
    heart.style.animationDuration = duration + "s";

    document.body.appendChild(heart);

    setTimeout(() => heart.remove(), duration * 1000);
  }

  setInterval(createHeart, 1000);
}
</script>

</body>
</html>
